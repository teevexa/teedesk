# TeeDesk — Caddy reverse proxy with automatic HTTPS
# Deploy to /etc/caddy/Caddyfile on your Oracle Cloud VM
# Replace YOUR_DOMAIN with e.g. yourname.duckdns.org

YOUR_DOMAIN {
    # WebSocket + REST API — proxy to FastAPI
    handle /api/* {
        reverse_proxy localhost:8000
    }

    # Frontend (React SPA) — serve built files + fallback to index.html
    handle {
        root * /var/www/teedesk
        try_files {path} /index.html
        file_server
    }

    # Compression
    encode gzip
}
