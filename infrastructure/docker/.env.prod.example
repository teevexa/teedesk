# TeeDesk — Production Environment Variables
# Copy this file to .env.prod and fill in all values
# NEVER commit .env.prod to git

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=teedesk
POSTGRES_USER=teedesk
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_random_password

# ─── FastAPI ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_64_hex_chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Your public domain (e.g. yourname.duckdns.org or desk.teedesk.com)
ALLOWED_ORIGINS=https://YOUR_DOMAIN_HERE

LOG_LEVEL=info
ENVIRONMENT=production

# Caddy is the one reverse proxy in front of the API in this stack — trust
# the X-Forwarded-For hop it appends (for rate limiting + audit log IPs).
# Leave at 0 (or unset) if you're not running behind Caddy/any proxy.
TRUSTED_PROXY_COUNT=1

# ─── Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b-instruct

# ─── AI Pipeline ──────────────────────────────────────────────
AI_PIPELINE_ENABLED=true
ENABLE_AUTO_ESCALATION=true
ESCALATION_SENTIMENT_THRESHOLD=-0.6
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.7

# ─── Database pool ────────────────────────────────────────────
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=0
