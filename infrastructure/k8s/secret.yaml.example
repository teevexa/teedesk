# ══════════════════════════════════════════════════════════════════
# DO NOT commit real secrets. This file is a PLACEHOLDER TEMPLATE ONLY.
#
# Copy it to secret.yaml (which should be gitignored) and fill in real
# values, or — preferred — generate the Secret directly on the cluster
# without ever writing plaintext to disk, e.g.:
#
#   kubectl create secret generic teedesk-secrets \
#     --namespace teedesk \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -hex 32)" \
#     --from-literal=REDIS_PASSWORD="$(openssl rand -hex 32)" \
#     --from-literal=SECRET_KEY="$(openssl rand -hex 32)" \
#     --from-literal=DATABASE_URL="postgresql+asyncpg://teedesk:<POSTGRES_PASSWORD>@postgres:5432/teedesk" \
#     --from-literal=REDIS_URL="redis://:<REDIS_PASSWORD>@redis:6379/0"
#
# Or better yet, use a secrets manager integration (External Secrets
# Operator, Sealed Secrets, SOPS, Vault, cloud provider secret store)
# instead of a raw kubectl-applied Secret in production.
#
# DATABASE_URL and REDIS_URL are pre-composed (password embedded) because
# Kubernetes does not support string-interpolating a Secret value from
# another key across objects the way docker-compose's ${VAR} substitution
# does — so if you change POSTGRES_PASSWORD/REDIS_PASSWORD you must also
# update DATABASE_URL/REDIS_URL to match.
# ══════════════════════════════════════════════════════════════════
apiVersion: v1
kind: Secret
metadata:
  name: teedesk-secrets
  namespace: teedesk
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME_strong_random_password"
  REDIS_PASSWORD: "CHANGE_ME_strong_random_password"
  # Generate with: openssl rand -hex 32
  SECRET_KEY: "CHANGE_ME_64_hex_chars"

  # Must stay in sync with POSTGRES_PASSWORD above and POSTGRES_DB/USER in configmap.yaml
  DATABASE_URL: "postgresql+asyncpg://teedesk:CHANGE_ME_strong_random_password@postgres:5432/teedesk"
  # Must stay in sync with REDIS_PASSWORD above
  REDIS_URL: "redis://:CHANGE_ME_strong_random_password@redis:6379/0"
