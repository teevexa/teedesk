# TeeDesk API — Environment Variables
# Copy to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://teedesk:teedesk_dev@localhost:5432/teedesk
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama (local LLM inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# Qdrant vector DB (optional — use pgvector if not set)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=teedesk_knowledge

# Feature flags
ENABLE_VOICE_ESCALATION=true
ENABLE_AUTO_ESCALATION=true
ESCALATION_SENTIMENT_THRESHOLD=-0.6

# Celery (background jobs)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# WhatsApp Business API (Meta Cloud API) — leave blank to disable
# See services/api/app/routers/whatsapp.py for setup instructions
WHATSAPP_VERIFY_TOKEN=choose-a-secret-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
