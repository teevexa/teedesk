# TeeDesk API — Environment Variables
# Copy to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of trusted reverse-proxy hops in front of this app (e.g. 1 if you
# run behind the included Caddy setup). 0 = ignore X-Forwarded-For entirely.
TRUSTED_PROXY_COUNT=0

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://teedesk:teedesk_dev@localhost:5432/teedesk
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama (local LLM inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# Feature flags
ENABLE_VOICE_ESCALATION=true
ENABLE_AUTO_ESCALATION=true
ESCALATION_SENTIMENT_THRESHOLD=-0.6

# Celery (background jobs)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# WhatsApp Business API (Meta Cloud API) — leave blank to disable.
# Also toggle "WhatsApp Integration" on for the tenant under Settings once
# credentials are set — inbound messages are dropped until both are true.
# See services/api/app/routers/whatsapp.py for setup instructions
WHATSAPP_VERIFY_TOKEN=choose-a-secret-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Telegram Bot API — leave blank to disable. Also toggle "Telegram Bot" on
# for the tenant under Settings. See app/routers/telegram.py for setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# SMTP (transactional email — verification, password reset). Leave
# SMTP_HOST blank to just log emails instead of sending them (dev default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@teedesk.local
SMTP_FROM_NAME=TeeDesk
FRONTEND_URL=http://localhost:5173

# Attachments (local disk storage)
ATTACHMENT_STORAGE_DIR=./data/attachments
MAX_ATTACHMENT_SIZE_MB=10

# Knowledge base document ingestion (PDF/DOCX upload)
MAX_KB_UPLOAD_SIZE_MB=20
